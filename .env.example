# Application
APP_NAME=NOVA-GeoRisk Intelligence Suite - FIRRIS Engine
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Replace for every environment. Production refuses an empty/default value.
INTERNAL_API_SECRET=replace-with-a-long-random-secret

# Browser API / BFF
INTERNAL_API_BASE_URL=http://api:8000
SESSION_COOKIE_NAME=nova_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
SESSION_REDIS_PREFIX=nova:bff:session:

# Leave blank until an owner selects a standards-compliant OIDC provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
OIDC_STATE_COOKIE_NAME=nova_oidc_state
OIDC_STATE_REDIS_PREFIX=nova:bff:oidc-state:
OIDC_STATE_TTL_SECONDS=600

# strict: administrators pre-provision users and memberships.
# optional_invite: a verified identity may redeem a one-time invitation token.
MEMBERSHIP_PROVISIONING_POLICY=strict
# Controlled development/staging bootstrap only. Production rejects true.
OIDC_BOOTSTRAP_FIRST_USER_ENABLED=false
OIDC_BOOTSTRAP_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# Browser access is through the same-origin BFF. Keep internal API CORS empty.
CORS_ALLOWED_ORIGINS=
EXPOSE_API_DOCS=false
PUBLIC_OUTPUTS_ENABLED=false

# Database
POSTGRES_USER=nova_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=nova_georisk
DATABASE_URL=postgresql+psycopg2://nova_user:replace-with-a-long-random-password@postgres:5432/nova_georisk
DB_ECHO=false

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Bound long-running geospatial workers and recycle them after heavy jobs.
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=10800
CELERY_TASK_TIME_LIMIT_SECONDS=14400
CELERY_WORKER_MAX_TASKS_PER_CHILD=1
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=3145728
CELERY_WORKER_CONCURRENCY=1
# Bounded organization queue and persisted analysis inputs
FIRRIS_MAX_PENDING_TASKS_PER_ORGANIZATION=32
FIRRIS_MAX_REQUEST_BYTES=16777216
FIRRIS_MAX_PREPARED_CELLS=1000000
FIRRIS_MAX_FEATURE_LAYERS=32

# Google Earth Engine
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/gee_service_account.json
GEE_PROJECT_ID=
# Absolute host path outside this repository; use a Linux or Windows path
# appropriate for the Docker host. Compose mounts it read-only into the API/worker.
GEE_SERVICE_ACCOUNT_HOST_PATH=/absolute/path/to/gee_service_account.json

# Optional map font overrides; defaults to bundled OS font or Pillow fallback.
NOVA_MAP_FONT_PATH=
NOVA_MAP_FONT_BOLD_PATH=

# Shared atlas storage
ARTIFACT_STORAGE_BACKEND=filesystem
OUTPUT_STORAGE_DIR=/app/outputs

# Deployment
DOMAIN_NAME=api.novageorisk.com
CERTBOT_EMAIL=
# Image built from the separate frontend repository at the same release version.
NOVA_FRONTEND_IMAGE=nova-georisk-frontend:local
