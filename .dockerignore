# Only production source and the separate test target's Python source enter the
# context. Git ignore rules do not apply to Docker working-tree builds.
**
!Dockerfile
!.dockerignore
!requirements.txt
!alembic.ini
!app/
!app/**/
!app/**/*.py
!app/services/source_data/firris_catalogue.json
!app/db/migrations/script.py.mako
!scripts/
!scripts/*.py
!tests/
!tests/**/
!tests/**/*.py

# Defense in depth: these exclusions must stay after the allowlist, including
# inside otherwise permitted source directories. No environment-file exception.
**/.env
**/.env.*
**/secrets
**/*service_account*.json
**/*credential*.json
**/*secret*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/cookies.txt
**/outputs
**/artifacts
**/data
**/datasets
**/raw-data
**/private-data
**/docx-files
**/docker-data
deploy/certbot/conf
deploy/certbot/www

**/.git
**/.agents
**/.codex
**/.aws
**/.ssh
**/.venv*
**/venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/*.py[cod]
**/*.egg-info
**/node_modules
**/build
**/dist
**/*.sqlite*
**/*.db
**/*.db-*
**/*.log
**/.coverage*
**/htmlcov
**/.idea
**/.vscode
**/.DS_Store
**/Thumbs.db

# Institutional uploads remain outside source/build trees.
**/external-datasets
